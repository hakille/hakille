// Akora shared components — Slint-native, no WebView.
// Tokens: fond sombre #0B0C0F / clair #F6F4F0, texte #ECEEF2/#14161B,
// braise #FF7A2F/#C2410C (validation/hold/decision-ring UNIQUEMENT),
// ligne #262A33/#DAD6CE, radius 12. Glyphe texte geometrique uniquement
// (✓ + − ● ○ → ×), JAMAIS d'emoji. Aucun toast/modale ici.

// Glyphe geometrique nomme -> caractere. Clefs: check, plus, minus,
// dot, circle, arrow, cross. Inconnu -> cercle vide (jamais d'emoji).
export component AkIcon inherits Text {
    in property <string> name;
    in property <bool> light-mode: false;
    text: root.name == "check" ? "✓" :
        root.name == "plus" ? "+" :
        root.name == "minus" ? "−" :
        root.name == "dot" ? "●" :
        root.name == "arrow" ? "→" :
        root.name == "cross" ? "×" : "○";
    color: root.light-mode ? #14161B : #ECEEF2;
    font-size: 13px;
}

// Bouton 44pt : Rectangle + FocusScope (clavier, anneau 2px) + TouchArea.
// kind: 0 primaire braise (validation), 1 secondaire contour,
// 2 tertiaire texte. Etats: survol voile 4%, presse 8%, desactive texte/3.
export component AkButton inherits Rectangle {
    in property <string> label;
    in property <int> kind: 0;
    in property <bool> enabled: true;
    in property <bool> light-mode: false;
    callback clicked();

    accessible-role: button;
    accessible-label: root.label;

    height: 44px;
    border-radius: 12px;
    border-width: root.kind == 1 ? 1px : 0px;
    border-color: root.light-mode ? #14161B : #ECEEF2;
    background: root.kind == 0
        ? (root.light-mode ? #C2410C : #FF7A2F)
        : transparent;
    opacity: root.enabled ? 1.0 : 0.34;

    animate background { duration: 120ms; }
    animate opacity { duration: 200ms; }

    fs := FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                if (root.enabled) { root.clicked(); }
                accept
            } else {
                reject
            }
        }
        touch := TouchArea {
            width: 100%;
            height: 100%;
            enabled: root.enabled;
            clicked => { root.clicked(); }
        }
    }

    // Voile d'etat : survol 4%, presse 8% (has-hover/pressed du vrai TouchArea).
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        background: #FFFFFF;
        opacity: touch.pressed ? 0.08 : (touch.has-hover ? 0.04 : 0.0);
    }

    // Anneau focus 2px, au-dessus du voile.
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        border-width: fs.has-focus ? 2px : 0px;
        border-color: root.kind == 0
            ? (root.light-mode ? #FFFFFF : #0B0C0F)
            : (root.light-mode ? #14161B : #ECEEF2);
        background: transparent;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;
        Text {
            text: root.label;
            color: root.kind == 0
                ? (root.light-mode ? #FFFFFF : #0B0C0F)
                : (root.light-mode ? #14161B : #ECEEF2);
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Pastille : glyphe + mot, jamais couleur seule.
export component AkPastille inherits Rectangle {
    in property <string> text;
    in property <string> icon: "dot";
    in property <bool> light-mode: false;
    height: 28px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.light-mode ? #DAD6CE : #262A33;
    background: transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: start;
        AkIcon {
            name: root.icon;
            light-mode: root.light-mode;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: root.light-mode ? #14161B : #ECEEF2;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// Interrupteur nomme : libelle + etat en toutes lettres, verrou distinct.
// locked => non cliquable, mention "verrouille par politique".
export component AkSwitch inherits Rectangle {
    in property <string> label;
    in property <bool> on: false;
    in property <bool> locked: false;
    in property <bool> light-mode: false;
    callback toggled();

    accessible-role: checkbox;
    accessible-label: root.label;

    height: 44px;
    border-radius: 12px;
    background: transparent;

    fs := FocusScope {
        width: 100%;
        height: 100%;
        enabled: !root.locked;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                if (!root.locked) { root.toggled(); }
                accept
            } else {
                reject
            }
        }
        TouchArea {
            width: 100%;
            height: 100%;
            enabled: !root.locked;
            clicked => { root.toggled(); }
        }
    }

    HorizontalLayout {
        padding: 8px;
        spacing: 12px;
        alignment: space-between;
        Text {
            text: root.label;
            color: root.light-mode ? #14161B : #ECEEF2;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
            Text {
                text: root.locked ? "○ verrouillé par politique" : (root.on ? "● activé" : "○ coupé");
                color: root.light-mode ? #4A5060 : #A3A9B6;
                font-size: 13px;
                vertical-alignment: center;
            }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        border-width: fs.has-focus ? 2px : 0px;
        border-color: root.light-mode ? #14161B : #ECEEF2;
        background: transparent;
    }
}

// Jauge : barre + valeur textuelle, seuils 80%/100% en mots.
// Braise UNIQUEMENT si ember=true (hold/validation/decision-ring).
export component AkGauge inherits Rectangle {
    in property <float> ratio: 0.0;
    in property <string> label;
    in property <bool> ember: false;
    in property <bool> light-mode: false;
    height: 44px;
    background: transparent;
    VerticalLayout {
        spacing: 4px;
        Text {
            text: root.label;
            color: root.light-mode ? #14161B : #ECEEF2;
            font-size: 13px;
        }
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                horizontal-stretch: 1;
                height: 8px;
                border-radius: 4px;
                background: root.light-mode ? #DAD6CE : #262A33;
                Rectangle {
                    x: 0;
                    y: 0;
                    height: 8px;
                    border-radius: 4px;
                    width: parent.width * (root.ratio < 0.0 ? 0.0 : (root.ratio > 1.0 ? 1.0 : root.ratio));
                    background: root.ember
                        ? (root.light-mode ? #C2410C : #FF7A2F)
                        : (root.light-mode ? #14161B : #ECEEF2);
                }
            }
            Text {
                text: (root.ratio >= 1.0 ? "atteinte" : (root.ratio >= 0.8 ? "au-delà de 80 %" : "normale")) + " — " + round(root.ratio * 100) + " %";
                color: root.light-mode ? #4A5060 : #A3A9B6;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
}
