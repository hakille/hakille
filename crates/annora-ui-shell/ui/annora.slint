// Akora Ambient Shell — Slint-native, no WebView.
// Design tokens (spec §3): surface/0 #0B0C0F, texte/1 #ECEEF2, braise #FF7A2F (validation ONLY).
// Geometry: HUD 720px, top-offset 120, blur 30, radius 12, evap 1500ms.
// Presence: Idle static 30% / Listening sine 2000ms / Acting 600ms.

import { LineEdit, ListView } from "std-widgets.slint";
import { AkButton } from "components.slint";
import { ActionCardScreen, WhyScreen, MemoryScreen, SettingsScreen, OnboardingScreen, OutboxScreen } from "screens.slint";

struct AnnoraTheme {
    bg: color,
    text: color,
    coral: color,
    border: color,
}

struct HudSpec {
    width: length,
    height: length,
    top-offset: length,
    opacity: float,
    blur: int,
    radius: int,
    visible: bool,
}

component PresenceDot inherits Rectangle {
    in property <int> presence-state: 0; // 0 Idle, 1 Listening, 2 Acting, 3 Speaking, 4 Decision, 5 Urgent
    in property <float> pulse: 0.0;      // 0..1 from pulse_factor()
    in property <bool> attention: false;
    in property <string> a11y-label: "Akora : veille ambiante";
    in property <bool> light-mode: false;
    callback tapped();

    accessible-role: button;
    accessible-label: root.a11y-label;

    width: 14px;
    height: 14px;
    border-radius: 7px;
    background: root.presence-state == 5
        ? (root.light-mode ? #C2410C : #FF7A2F)
        : (root.light-mode ? #14161B : #F4EBDD);
    opacity: root.presence-state == 0 ? 0.4 : 0.6 + 0.4 * pulse;
    border-width: (root.presence-state == 2 || root.presence-state == 4 || root.presence-state == 5) ? 1px : 0px;
    border-color: (root.presence-state == 4 || root.presence-state == 5)
        ? (root.light-mode ? #C2410C : #FF7A2F) : #ECEEF2;

    animate opacity { duration: 200ms; }

    TouchArea {
        clicked => { root.tapped(); }
    }
}

component HudBar inherits Rectangle {
    in-out property <string> query: "";
    in property <string> response: "";
    in property <bool> streaming: false;
    in property <bool> needs-validation: false;
    in property <string> validation-text: "";
    in property <string> validation-cost: "";
    in property <float> evap-frac: 1.0;
    in property <bool> high-contrast: false;
    in property <bool> light-mode: false;
    callback submitted(string);
    callback validated();
    callback cancelled();

    background: root.light-mode ? #F6F4F0 : #0B0C0F;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.high-contrast ? #FFFFFF : (root.light-mode ? #DAD6CE : #262A33);

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        LineEdit {
            text <=> root.query;
            accessible-label: "Commande Akora — Entrée pour envoyer, Échap pour fermer";
            accepted => { root.submitted(root.query); }
        }
        Text {
            text: root.response;
            color: root.high-contrast ? #FFFFFF : (root.light-mode ? #14161B : #ECEEF2);
            font-size: 14px;
            visible: root.response != "";
            opacity: root.evap-frac;
            animate opacity { duration: 200ms; }
        }
        Rectangle {
            visible: root.needs-validation;
            background: #FF7A2F;
            border-radius: 8px;
            height: 128px;
            opacity: 1.0;
            animate opacity { duration: 200ms; }
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                Text {
                    text: root.validation-text + "  " + root.validation-cost;
                    color: root.light-mode ? #FFFFFF : #0B0C0F;
                    font-size: 13px;
                }
                HorizontalLayout {
                    spacing: 8px;
                    AkButton {
                        label: "Valider (Entrée)";
                        kind: 0;
                        light-mode: root.light-mode;
                        horizontal-stretch: 1;
                        clicked => { root.validated(); }
                    }
                    AkButton {
                        label: "Annuler (Échap)";
                        kind: 1;
                        light-mode: root.light-mode;
                        horizontal-stretch: 1;
                        clicked => { root.cancelled(); }
                    }
                }
            }
        }
    }
}

component CostBar inherits Rectangle {
    in property <string> cost-label: "0.00 EUR";
    // 0 normal, 1 near >=80%, 2 exceeded
    in property <int> level: 0;
    in property <bool> light-mode: false;
    background: root.light-mode ? #F6F4F0 : #0B0C0F;
    Text {
        text: root.cost-label;
        color: root.level == 2
            ? (root.light-mode ? #C2410C : #FF7A2F)
            : (root.light-mode ? #14161B : #ECEEF2);
    }
}

component SilenceGauge inherits Rectangle {
    in property <string> silence-label: "3 / 3";
    in property <bool> light-mode: false;
    background: root.light-mode ? #F6F4F0 : #0B0C0F;
    Text {
        text: root.silence-label;
        color: root.light-mode ? #14161B : #ECEEF2;
    }
}

component JournalPanel inherits Rectangle {
    // Frise groupée par jour, 56 pt/ligne, Annuler au clavier (spec §8, §26).
    in property <[string]> lines;
    in property <bool> light-mode: false;
    callback revert-selected(int);
    background: transparent;
    VerticalLayout {
        spacing: 4px;
        Text {
            text: "Journal — frise, annulation en un geste";
            color: root.light-mode ? #4A5060 : #A3A9B6;
            font-size: 13px;
        }
        ListView {
            accessible-label: "Entrées du journal, plus récent d'abord";
            for line[i] in root.lines: Text {
                text: line;
                color: root.light-mode ? #14161B : #ECEEF2;
                font-size: 13px;
            }
        }
    }
}

component PowersPanel inherits Rectangle {
    // Pouvoirs : groupe + périmètre + jauge + interrupteur (spec §8).
    in property <[string]> lines;
    in property <bool> light-mode: false;
    callback toggled(int);
    callback kill-all();
    background: transparent;
    VerticalLayout {
        spacing: 4px;
        Text {
            text: "Pouvoirs — interrupteur nommé, verrou politique distinct";
            color: root.light-mode ? #4A5060 : #A3A9B6;
            font-size: 13px;
        }
        ListView {
            accessible-label: "Pouvoirs accordés et refusés";
            for line[i] in root.lines: Text {
                text: line;
                color: root.light-mode ? #14161B : #ECEEF2;
                font-size: 13px;
            }
        }
    }
}

export component AnnoraWindow inherits Window {
    in property <AnnoraTheme> theme: {
        bg: #0B0C0F, text: #ECEEF2, coral: #FF7A2F, border: #262A33
    };
    in property <int> presence-state;
    in property <float> presence-pulse;
    in property <bool> presence-attention;
    in property <string> hud-query: "";
    in property <string> hud-response: "";
    in property <bool> hud-streaming: false;
    in property <bool> hud-validation: false;
    in property <string> hud-validation-text: "";
    in property <string> hud-validation-cost: "";
    in property <string> cost-label: "0.00 EUR";
    in property <int> cost-level: 0;
    in property <string> silence-label: "3 / 3";
    in property <bool> high-contrast: false;
    in property <bool> light-mode: false;
    in property <string> presence-a11y-label: "Akora : veille ambiante";
    in property <[string]> journal-lines;
    in property <[string]> powers-lines;
    // Navigation : 0 Journal, 1 Mémoire, 2 Pouvoirs, 3 Réglages.
    // in-out : la rangée tactile ET le Rust (render/tests) l'écrivent.
    in-out property <int> destination: 0;
    // Onboarding : overlay tant que faux.
    in property <bool> onboarding-ready: true;
    in property <[string]> onboarding-limits;
    in property <[string]> onboarding-caps;
    // Carte d'action (overlay quand hud-validation).
    in property <string> card-verb: "";
    in property <string> card-object: "";
    in property <string> card-reason: "";
    in property <string> card-why-trace: "";
    in property <string> card-cost: "";
    in property <string> card-data: "";
    in property <string> card-reversibility: "";
    in property <string> card-provenance: "";
    in property <bool> card-external: false;
    in property <bool> card-needs-hold: false;
    in property <float> card-hold-progress: 0.0;
    // Feuille Pourquoi (destination 0).
    in property <string> why-sentence: "";
    in property <[string]> why-facts;
    in property <string> why-plan: "";
    in property <[string]> why-powers;
    in property <string> why-confidence: "";
    in property <[string]> why-alternatives;
    in property <string> why-model-line: "";
    in property <string> why-cost-line: "";
    in property <string> why-data-line: "";
    in property <string> why-would-change: "";
    // Mémoire (destination 1).
    in property <[string]> memory-rows;
    in property <[string]> memory-partitions;
    in property <int> memory-selected: 0;
    in property <string> memory-contra: "";
    // Réglages (destination 3) : rows + states[i] (1 active, 0 coupe).
    in property <[string]> settings-rows;
    in property <[int]> settings-states;
    // Outbox (destination 0).
    in property <[string]> outbox-rows;

    callback presence-tapped();
    callback hud-submitted(string);
    callback hud-validated();
    callback hud-cancelled();
    callback journal-revert(int);
    callback power-toggled(int);
    callback powers-kill-all();
    callback card-approve();
    callback card-edit();
    callback card-reject();
    callback fact-disputed(string);
    callback memory-select-partition(int);
    callback memory-forget(string);
    callback settings-toggled(int);
    callback onboarding-acknowledge();
    callback outbox-revalidate(int);
    callback outbox-flush();
    callback destination-selected(int);

    title: "Akora";
    background: root.light-mode ? #F6F4F0 : theme.bg;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        PresenceDot {
            presence-state: root.presence-state;
            pulse: root.presence-pulse;
            attention: root.presence-attention;
            a11y-label: root.presence-a11y-label;
            light-mode: root.light-mode;
            tapped => { root.presence-tapped(); }
        }
        HudBar {
            query: root.hud-query;
            response: root.hud-response;
            streaming: root.hud-streaming;
            needs-validation: root.hud-validation;
            validation-text: root.hud-validation-text;
            validation-cost: root.hud-validation-cost;
            high-contrast: root.high-contrast;
            light-mode: root.light-mode;
            submitted(q) => { root.hud-submitted(q); }
            validated => { root.hud-validated(); }
            cancelled => { root.hud-cancelled(); }
        }
        if !root.onboarding-ready : OnboardingScreen {
            limits: root.onboarding-limits;
            caps: root.onboarding-caps;
            ready: root.onboarding-ready;
            light-mode: root.light-mode;
            acknowledge => { root.onboarding-acknowledge(); }
        }
        if root.hud-validation : ActionCardScreen {
            verb: root.card-verb;
            object: root.card-object;
            reason: root.card-reason;
            why-trace: root.card-why-trace;
            cost: root.card-cost;
            data: root.card-data;
            reversibility: root.card-reversibility;
            provenance: root.card-provenance;
            external: root.card-external;
            needs-hold: root.card-needs-hold;
            hold-progress: root.card-hold-progress;
            light-mode: root.light-mode;
            approve => { root.card-approve(); }
            edit => { root.card-edit(); }
            reject => { root.card-reject(); }
        }
        HorizontalLayout {
            spacing: 8px;
            AkButton {
                label: "Journal";
                kind: root.destination == 0 ? 0 : 1;
                light-mode: root.light-mode;
                horizontal-stretch: 1;
                clicked => { root.destination = 0; root.destination-selected(0); }
            }
            AkButton {
                label: "Mémoire";
                kind: root.destination == 1 ? 0 : 1;
                light-mode: root.light-mode;
                horizontal-stretch: 1;
                clicked => { root.destination = 1; root.destination-selected(1); }
            }
            AkButton {
                label: "Pouvoirs";
                kind: root.destination == 2 ? 0 : 1;
                light-mode: root.light-mode;
                horizontal-stretch: 1;
                clicked => { root.destination = 2; root.destination-selected(2); }
            }
            AkButton {
                label: "Réglages";
                kind: root.destination == 3 ? 0 : 1;
                light-mode: root.light-mode;
                horizontal-stretch: 1;
                clicked => { root.destination = 3; root.destination-selected(3); }
            }
        }
        if root.destination == 0 : VerticalLayout {
            spacing: 12px;
            JournalPanel {
                lines: root.journal-lines;
                light-mode: root.light-mode;
                revert-selected(i) => { root.journal-revert(i); }
            }
            WhyScreen {
                sentence: root.why-sentence;
                facts: root.why-facts;
                plan: root.why-plan;
                powers: root.why-powers;
                confidence: root.why-confidence;
                alternatives: root.why-alternatives;
                model-line: root.why-model-line;
                cost-line: root.why-cost-line;
                data-line: root.why-data-line;
                would-change: root.why-would-change;
                light-mode: root.light-mode;
                fact-disputed(s) => { root.fact-disputed(s); }
            }
            OutboxScreen {
                rows: root.outbox-rows;
                light-mode: root.light-mode;
                revalidate(i) => { root.outbox-revalidate(i); }
                flush => { root.outbox-flush(); }
            }
        }
        if root.destination == 1 : MemoryScreen {
            rows: root.memory-rows;
            partitions: root.memory-partitions;
            selected: root.memory-selected;
            contra-label: root.memory-contra;
            light-mode: root.light-mode;
            select-partition(i) => { root.memory-select-partition(i); }
            forget(s) => { root.memory-forget(s); }
        }
        if root.destination == 2 : PowersPanel {
            lines: root.powers-lines;
            light-mode: root.light-mode;
            toggled(i) => { root.power-toggled(i); }
            kill-all() => { root.powers-kill-all(); }
        }
        if root.destination == 3 : SettingsScreen {
            rows: root.settings-rows;
            states: root.settings-states;
            light-mode: root.light-mode;
            toggled(i) => { root.settings-toggled(i); }
        }
        CostBar {
            cost-label: root.cost-label;
            level: root.cost-level;
            light-mode: root.light-mode;
        }
        SilenceGauge {
            silence-label: root.silence-label;
            light-mode: root.light-mode;
        }
    }
}
